{
  "name": "simulora",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning server/main.ts",
    "fake": "node --disable-warning=ExperimentalWarning server/main.ts --fake",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/main.ts --prod",
    "typecheck": "tsc",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
